PORT=3000
DATABASE_URL=postgresql://sportsai:sportsaipassword@localhost:5432/sportsai_db

# Local Intelligence Engine (Ollama Phi-3 Mini Primary, Qwen Fallback)
LLM_PROVIDER=ollama
OLLAMA_HOST=http://127.0.0.1:11434
PRIMARY_MODEL=phi3:latest
SECONDARY_MODEL=qwen3:4b

# Optional Cloud LLMs
GEMINI_API_KEY=
OPENAI_API_KEY=
GROK_API_KEY=

# ========================================================
# REAL-TIME SPORTS DATA APIS
# ========================================================
# 1. Cricket — OpenCricket API (https://opencricketapi.com/)
# Alternative: CricAPI (https://cricketdata.org/)
OPENCRICKET_API_KEY=
CRICKET_API_KEY=
CRICAPI_KEY=
CRICBUZZ_API_KEY=

# 2. Football — API-Football (https://dashboard.api-football.com/)
# Supports Premier League, Bundesliga, LaLiga, UEFA Champions League
API_FOOTBALL_KEY=
FOOTBALL_API_KEY=
# Fallback free tier: football-data.org (https://www.football-data.org/)
FOOTBALL_DATA_API_KEY=

# 3. Badminton — Badminton API (https://badmintonapi.com/)
# Supports BWF Tournaments, Live Game Scores, and BWF World Rankings
BADMINTON_API_KEY=
RAPIDAPI_KEY=
